# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env
cloud-tool/

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Temp / output ─────────────────────────────────────────────────────────────
/tmp/
*.sgm
*.sgml
*.docx
*.pdf
*.log
# Golden-file regression fixtures ARE meant to be committed (see tests/test_golden.py)
!tests/golden/**/*.docx
!tests/golden/**/*.sgm

# ── Data (large files) — add selectively ─────────────────────────────────────
# chroma_db IS tracked (via Git LFS - see .gitattributes) so a fresh clone has
# a working RAG index (78 rule chunks, 5481 vendor examples) out of the box.
# Keep vendor_sgms tracked (small SGM files for RAG)
# data/vendor_sgms/  ← intentionally not ignored

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.ActivationToken
*.key
*.pem
# ABBYY license files/installers — per ABBYY's own docs: never commit these
*.ABBYY.*
FRE*.sh

# ── Docker build: local artifacts regenerated per build, not committed ──────
# .wheel_cache: `pip3 download` output for requirements.txt (see scripts/build_push.sh)
# abbyy_bundle: staged from an already-installed, working ABBYY FRE12 (same script) —
# ~3.3GB, machine-specific, and must never contain license/token files (see above)
.wheel_cache/
abbyy_bundle/
