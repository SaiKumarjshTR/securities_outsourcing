# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env
cloud-tool/

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Temp / output ─────────────────────────────────────────────────────────────
/tmp/
*.sgm
*.sgml
*.docx
*.pdf
*.log
# Golden-file regression fixtures ARE meant to be committed (see tests/test_golden.py)
!tests/golden/**/*.docx
!tests/golden/**/*.sgm

# ── Data (large files) — add selectively ─────────────────────────────────────
# chroma_db IS tracked (via Git LFS - see .gitattributes) so a fresh clone has
# a working RAG index (78 rule chunks, 5481 vendor examples) out of the box.
# Keep vendor_sgms tracked (small SGM files for RAG)
# data/vendor_sgms/  ← intentionally not ignored

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.ActivationToken
*.key
*.pem
